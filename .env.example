PORT=3000
DATABASE_URL=postgres://localhost:5432/safenet

# Nemotron (build.nvidia.com) — pick a model with tool calling
NVIDIA_API_KEY=
NEMOTRON_MODEL=
# Optional: prepended to system prompts, e.g. "/no_think" or "detailed thinking off"
NEMOTRON_SYSTEM_PREFIX=

# Photon / Retell (voice over SIP, texts on same number)
PHOTON_API_KEY=
PHOTON_PHONE_NUMBER=
RETELL_API_KEY=
RETELL_AGENT_ID=
PUBLIC_BASE_URL=

# true = simulated calls/texts (demo backup)
MOCK_CALLS=true
COORDINATOR_BATCH=5
COORDINATOR_INTERVAL_MS=15000
