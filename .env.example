PORT=3000
DATABASE_URL=postgres://localhost:5432/safenet

# Nemotron — hosted API (build.nvidia.com). For a Nemotron NIM on Brev, set NEMOTRON_BASE_URL to its /v1 URL.
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Brev/self-hosted: its /v1 URL + its API key (NVIDIA_API_KEY stays as the hosted fallback)
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=
# Optional: prepended to system prompts, e.g. "/no_think" or "detailed thinking off"
NEMOTRON_SYSTEM_PREFIX=
# true = coordinator reasons before each tool call (slower, reasoning shown in agent log)
NEMOTRON_COORDINATOR_THINKING=false

# LiveKit Cloud (voice). Photon number ⇄ SIP ⇄ LiveKit. See docs/voice-setup.md
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_AGENT_NAME=safenet-caller
LIVEKIT_STT=deepgram/nova-3
LIVEKIT_TTS=cartesia/sonic-3

# Photon (number for calls). Texting is off unless TEXTS_ENABLED=true
TEXTS_ENABLED=false
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
PHOTON_SIP_HOST=sip.photon.codes
PHOTON_SIP_PORT=5061
PHOTON_SIP_USERNAME=
PHOTON_SIP_PASSWORD=
PHOTON_PHONE_NUMBER=

# Agent process → API
INTERNAL_API_URL=http://localhost:3000
INTERNAL_TOKEN=change-me

# Team phones for the 2 demo policyholders (Zoom, Peyton) — set by npm run db:setup, never committed.
DEMO_PHONES=
# Comma-separated phones that get REAL calls when MOCK_CALLS=false; everyone else is simulated.
LIVE_CALL_ALLOWLIST=
# true = simulated calls/texts (demo backup). Mock calls still run the real Nemotron call brain.
MOCK_CALLS=true
# Simulated calls use scripted turns unless true (Nemotron quota goes to coordinator/triage/escalation)
SIM_CALLS_USE_NEMOTRON=false
COORDINATOR_BATCH=5
COORDINATOR_INTERVAL_MS=15000

# National Weather Service live alerts (POST /api/alerts/nws/sync). Poll = 0 → only on demand.
NWS_AREA=TX
NWS_POLL_MINUTES=0
